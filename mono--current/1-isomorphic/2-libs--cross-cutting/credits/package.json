{
	"name": "@monorepo-private/credits",
	"version": "0.0.1",
	"private": true,
	"description": "Lib for crediting creators (mainly of assets) and tracking the recent usage of assets for dynamic crediting",
	"type": "module",
	"sideEffects": true,
	"exports": {
		".": "./module/src/index.ts",
		"./authors/*": "./module/src/l3-authors/*/index.ts"
	},
	"scripts": {
		"_check": "run-s check:ts",
		"check:ts": "echo \"@monorepo-private/credits\" && tsc --noEmit",
		"demo": "node --env-file-if-exists=.env.local --experimental-webstorage --localstorage-file=.node-ls.local ./module/##demo/index.ts",
		"dev": "run-s  watch:check:ts",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"@monorepo-private/marketing--creator": "workspace:*"
	},
	"devDependencies": {
		"@monorepo-private/config--mocha": "workspace:*",
		"@monorepo-private/config--typescript": "workspace:*",
		"@monorepo-private/scripts": "workspace:*",
		"@monorepo-private/ts--types": "workspace:*",
		"@monorepo-private/ts--types--hypermedia": "workspace:*",
		"@types/mocha": "catalog:",
		"@types/node": "catalog:",
		"@types/sinon": "catalog:",
		"chai": "catalog:",
		"mocha": "catalog:",
		"npm-run-all": "catalog:",
		"sinon": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tslib": "catalog:"
	},
	"// @infinite-monorepo/plugin--package-json": "auto generated some content in this file"
}
