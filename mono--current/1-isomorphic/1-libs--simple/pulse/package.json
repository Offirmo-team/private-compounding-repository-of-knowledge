{
	"name": "@monorepo-private/pulse",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./module/src/index.ts"
	},
	"scripts": {
		"_clean--pkg": "monorepo-script--clean-package …cache …dist",
		"_start:demo--parcel": "parcel serve module/doc/demo/storypad.html --port 1981 --lazy --no-autoinstall",
		"_start:demo--vite": "vite --port 1981 --strictPort --logLevel info --open module/doc/demo/storypad.html",
		"_start:storypad--parcel": "parcel serve module/doc/demo/storypad.html --port 1981 --lazy --no-autoinstall",
		"_start:storypad--vite": "vite --port 1981 --strictPort --logLevel info --open module/doc/demo/storypad.html",
		"check": "run-s check:ts",
		"check:ts": "echo \"@monorepo-private/pulse\" && tsc --noEmit",
		"clean": "npm-run-all _clean--pkg",
		"demo": "npm-run-all clean --parallel _start:demo--vite",
		"demop": "npm-run-all clean --parallel _start:demo--parcel",
		"dev": "run-s clean watch:check:ts",
		"stories": "npm-run-all clean --parallel _start:storypad--vite",
		"storiesp": "npm-run-all clean --parallel _start:storypad--parcel",
		"watch:check:ts": "tsc --noEmit --watch"
	},
