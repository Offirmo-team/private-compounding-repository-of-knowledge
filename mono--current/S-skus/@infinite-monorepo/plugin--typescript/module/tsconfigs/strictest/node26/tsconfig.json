{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": [
		/* https://github.com/tsconfig/bases?tab=readme-ov-file#node-26-tsconfigjson (update marker) */
		"@tsconfig/node26/tsconfig.json",
		/* https://github.com/tsconfig/bases?tab=readme-ov-file#node-with-typescript-ts-58-only-tsconfigjson */
		"@tsconfig/node-ts/tsconfig.json",
		"../isomorphic/tsconfig.json"
	],

	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",

		"lib": [
			"ES2025", // see target (update marker)
			"ESNext.Temporal" // native since node 26, needs re-adding since "lib" from isomorphic overrides @tsconfig/node26's
		]
	}
}
