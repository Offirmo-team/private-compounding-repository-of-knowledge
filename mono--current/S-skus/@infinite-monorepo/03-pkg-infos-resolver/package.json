{
	"name": "@infinite-monorepo/pkg-infos-resolver",
	"version": "0.0.1",
	"private": true,
	"description": "Fetch the latest infos about a npm package: version, typings, etc.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./module/src/index.ts"
	},
	"scripts": {
		"check": "run-s test--vitest check:ts",
		"check:ts": "echo \"@infinite-monorepo/pkg-infos-resolver\" && tsc --noEmit",
		"dev": "run-s  watch:check:ts",
		"sandbox": "node --env-file-if-exists=.env.local --experimental-webstorage --localstorage-file=.node-ls.local ./module/##sandbox/index.ts",
		"test--vitest": "vitest run --dir module --exclude '**/~~*/**'",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"@monorepo-private/utils--async": "workspace:*",
		"semver": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@monorepo-private/config--typescript": "workspace:*",
		"@monorepo-private/scripts": "workspace:*",
		"@monorepo-private/ts--types": "workspace:*",
		"@types/node": "catalog:",
		"@types/semver": "catalog:",
		"npm-run-all": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tslib": "catalog:"
	},
	"// @infinite-monorepo/plugin--pm--package-json": "auto generated some content in this file"
}
