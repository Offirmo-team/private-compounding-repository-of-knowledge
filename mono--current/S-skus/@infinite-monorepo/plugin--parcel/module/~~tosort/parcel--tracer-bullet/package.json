{
	"name": "@monorepo-private/parcel--tracer-bullet",
	"version": "0.0.1",
	"private": true,
	"description": "Unfortunately parcel JS is very unstable 😢 This basic project tries to use it in a very simple way, to pinpoint issues.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./module/src/index.html"
	},
	"scripts": {
		"_clean--pkg": "monorepo-script--clean-package …cache …dist",
		"_start:main--parcel": "parcel serve module/src/index.html --port 1981 --lazy --no-autoinstall",
		"_start:main--vite": "vite --port 1981 --strictPort --logLevel info --open module/src/index.html",
		"_start:parcel:main": "parcel serve module/*.html --port 1981 --lazy --no-autoinstall",
		"check": "run-s check:ts",
		"check:ts": "echo \"@monorepo-private/parcel--tracer-bullet\" && tsc --noEmit",
		"clean": "npm-run-all _clean--pkg",
		"dev": "run-s clean watch:check:ts",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"@monorepo-private/normalize-string": "workspace:*"
	},
	"devDependencies": {
		"@monorepo-private/config--typescript": "workspace:*",
		"@monorepo-private/parcel-config": "workspace:*",
		"@monorepo-private/scripts": "workspace:*",
		"@monorepo-private/storypad": "workspace:*",
		"@monorepo-private/vite--config--default": "workspace:*",
		"@types/node": "catalog:",
		"npm-run-all": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tslib": "catalog:"
	},
	"// @infinite-monorepo/plugin--pm--package-json": "auto generated some content in this file"
}
