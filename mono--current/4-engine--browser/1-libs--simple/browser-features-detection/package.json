{
	"name": "@monorepo-private/browser-features-detection",
	"version": "0.0.1",
	"private": true,
	"description": "My own feature detection lib",
	"type": "module",
	"sideEffects": true,
	"exports": {
		".": "./module/src/index.ts",
		"./has-hover": "./module/src/l3-has-hover/_entrypoint.ts",
		"./infer-channel": "./module/src/l2-infer-channel/_entrypoint.ts",
		"./is-framed": "./module/src/l1-is-framed/_entrypoint.ts",
		"./is-localhost": "./module/src/l1-is-localhost/_entrypoint.ts",
		"./is-tunneled": "./module/src/l1-is-tunneled/_entrypoint.ts",
		"./uses-tab": "./module/src/l3-uses-tab/_entrypoint.ts"
	},
	"scripts": {
		"_clean--pkg": "monorepo-script--clean-package …cache …dist",
		"_start:storypad--parcel": "parcel serve module/__fixtures/storypad/index.html --port 1981 --lazy --no-autoinstall",
		"_start:storypad--vite": "vite --port 1981 --strictPort --logLevel info --open module/__fixtures/storypad/index.html",
		"check": "run-s check:ts",
		"check:ts": "echo \"@monorepo-private/browser-features-detection\" && tsc --noEmit",
		"clean": "npm-run-all _clean--pkg",
		"dev": "run-s clean watch:check:ts",
		"stories": "npm-run-all clean --parallel _start:storypad--vite",
		"storiesp": "npm-run-all clean --parallel _start:storypad--parcel",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"memoize-one": "catalog:"
	},
	"devDependencies": {
		"@monorepo-private/config--mocha": "workspace:*",
		"@monorepo-private/config--typescript": "workspace:*",
		"@monorepo-private/parcel-config": "workspace:*",
		"@monorepo-private/scripts": "workspace:*",
		"@monorepo-private/vite--config--default": "workspace:*",
		"@types/mocha": "catalog:",
		"@types/node": "catalog:",
		"@types/sinon": "catalog:",
		"chai": "catalog:",
		"mocha": "catalog:",
		"npm-run-all": "catalog:",
		"sinon": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"tslib": "catalog:"
	},
	"// @infinite-monorepo/plugin--package-json": "auto generated some content in this file"
}
