{
	"name": "@monorepo-private/font--smallest",
	"version": "0.0.1",
	"private": true,
	"description": "Asset: font, smallest size possible for technical use, ex. discreetly displaying a version",
	"type": "module",
	"sideEffects": true,
	"exports": {
		".": "./module/index.tsx"
	},
	"scripts": {
		"_clean--pkg": "monorepo-script--clean-package …cache …dist",
		"_start:storypad--parcel": "parcel serve module/__fixtures/storypad/index.html --port 1981 --lazy --no-autoinstall",
		"_start:storypad--vite": "vite --port 1981 --strictPort --logLevel info --open module/__fixtures/storypad/index.html",
		"check": "run-s check:ts",
		"check:ts": "echo \"@monorepo-private/font--smallest\" && tsc --noEmit",
		"clean": "npm-run-all _clean--pkg",
		"dev": "run-s clean watch:check:ts",
		"stories": "npm-run-all clean --parallel _start:storypad--vite",
		"storiesp": "npm-run-all clean --parallel _start:storypad--parcel",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"@monorepo-private/credits": "workspace:*"
	},
	"devDependencies": {
