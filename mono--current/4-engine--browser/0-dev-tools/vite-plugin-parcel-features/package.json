{
	"name": "@monorepo-private/vite-plugin-parcel-features",
	"version": "0.0.1",
	"private": true,
	"description": "Vite plugin backfilling some Parcel features our sources rely on, ex. image transform directives",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./module/src/index.ts"
	},
	"scripts": {
		"check": "run-s test--vitest test--mocha check:ts",
