{
	"name": "@monorepo-private/storypad",
	"version": "0.0.1",
	"private": true,
	"description": "Storybook replacement",
	"type": "module",
	"sideEffects": true,
	"exports": {
		".": "./module/src/index.ts",
		"./decorators/diagnostics": "./module/src/__shared/decorators/diagnostics/_entrypoint.ts",
		"./stories/html/elements/*": "./module/src/__shared/stories/html/elements/*.stories.ts",
		"./stories/html/html-demos--offirmo": "./module/src/__shared/stories/html/html-demos-by-offirmo.stories.ts",
		"./stories/html/html-demos--others": "./module/src/__shared/stories/html/html-demos-misc.stories.ts",
		"./stories/html/html5-kitchen-sink": "./module/src/__shared/stories/html/html5-kitchen-sink_by_dbox.stories.ts",
		"./stories/html/motherfuckingwebsites": "./module/src/__shared/stories/html/motherfuckingwebsites.stories.ts",
		"./types": "./module/src/l0-types/_entrypoint.ts"
	},
	"scripts": {
		"_check": "run-s test check:ts",
		"_clean--pkg": "monorepo-script--clean-package …cache …dist",
		"_start:storypad--parcel": "parcel serve module/__fixtures/storypad/index.html --port 1981 --lazy --no-autoinstall",
		"_start:storypad--vite": "vite --port 1981 --strictPort --logLevel info --open module/__fixtures/storypad/index.html",
		"check:ts": "echo \"@monorepo-private/storypad\" && tsc --noEmit",
		"clean": "npm-run-all _clean--pkg",
		"dev": "run-s clean watch:check:ts",
		"start": "npm-run-all clean --parallel _start:main--vite",
		"startp": "npm-run-all clean --parallel _start:main--parcel",
		"stories": "npm-run-all clean --parallel _start:storypad--vite",
		"storiesp": "npm-run-all clean --parallel _start:storypad--parcel",
		"test": "node --env-file-if-exists=.env.local --experimental-webstorage --localstorage-file=.node-ls.local ./node_modules/mocha/bin/mocha.js -- --bail --config ./node_modules/@monorepo-private/config--mocha/module/mocharc.json ./node_modules/@monorepo-private/config--mocha/module/mocha-chai-init-node.mjs './module/**/*.tests.ts' --ignore '**/~~*/**'",
		"watch:check:ts": "tsc --noEmit --watch"
	},
	"dependencies": {
		"@monorepo-private/assert": "workspace:*",
		"@monorepo-private/better-console-groups": "workspace:*",
		"@monorepo-private/browser-features-detection": "workspace:*",
		"@monorepo-private/data-structures": "workspace:*",
		"@monorepo-private/rich-text-format": "workspace:*",
		"@monorepo-private/soft-execution-context--browser": "workspace:*",
		"@monorepo-private/universal-debug-api--browser": "workspace:*",
		"@monorepo-private/utils--async": "workspace:*",
		"core-js": "catalog:",
		"emittery": "catalog:",
		"prop-types": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tslib": "catalog:",
		"typescript-string-enums": "catalog:"
	},
	"devDependencies": {
		"@monorepo-private/config--mocha": "workspace:*",
		"@monorepo-private/config--typescript": "workspace:*",
		"@monorepo-private/css--utils--diagnostics": "workspace:*",
		"@monorepo-private/parcel-config": "workspace:*",
		"@monorepo-private/scripts": "workspace:*",
		"@monorepo-private/soft-execution-context": "workspace:*",
		"@monorepo-private/ts--types": "workspace:*",
		"@monorepo-private/ts--types--hypermedia": "workspace:*",
		"@monorepo-private/vite--config--default": "workspace:*",
		"@types/chai": "catalog:",
		"@types/core-js": "catalog:",
		"@types/mocha": "catalog:",
		"@types/node": "catalog:",
		"@types/prop-types": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/sinon": "catalog:",
		"chai": "catalog:",
		"mocha": "catalog:",
		"npm-run-all": "catalog:",
		"sinon": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"// @infinite-monorepo/plugin--package-json": "auto generated some content in this file",
	"alias": {
		"@storybook/test": "./module/src/l3-compat/@storybook/test.ts"
	}
}
